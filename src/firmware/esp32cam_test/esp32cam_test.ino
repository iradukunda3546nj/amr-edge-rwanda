<div id="status">Drag a box around the digit window.</div></div></section>
<section class="panel"><div class="head">Result</div><div class="body">
<div class="reading" id="reading">&mdash;</div><table id="res"></table><br><table id="wh"></table></div></section>
</main>
<script>
const $=id=>document.getElementById(id);let box=null,drag=null,last=null;
try{box=JSON.parse(localStorage.getItem('amrBox'))}catch(e){}
try{const n=localStorage.getItem('amrN');if(n)$('n').value=n}catch(e){}
function rows(t,r){t.innerHTML=r.map(([k,v])=>`<tr><th>${k}</th><td class="mono">${v}</td></tr>`).join('')}
async function selftest(run){const s=await (await fetch('/selftest'+(run?'?run=1':''))).json();
const ok=s.exact===s.golden_n&&s.pre_exact===s.pre_n;$('hmirror').checked=!!s.hmirror;$('vflip').checked=!!s.vflip;
rows($('st'),[['Result',`<span class="${ok?'pass':'fail'}">${ok?'PASS':'FAIL'}</span>`],
['Kernels vs TFLite',`${s.exact}/${s.golden_n} vectors bit-exact`],['Top-1 vs label',`${s.label_hits}/${s.golden_n}`],
['Preprocessing vs Python',`${s.pre_exact}/${s.pre_n} identical (max diff ${s.pre_max_diff})`],
['Inference per wheel',`${(s.infer_us/1000).toFixed(2)} ms (${s.macs.toLocaleString()} MACs)`],
['Preprocessing per wheel',`${(s.pre_us/1000).toFixed(2)} ms`],['Throughput',`${(s.macs/s.infer_us).toFixed(1)} MMAC/s at ${s.cpu_mhz} MHz`],
['Memory free',`heap ${(s.free_heap/1024).toFixed(0)} KB, PSRAM ${(s.free_psram/1024).toFixed(0)} KB`]])}
function draw(){const c=$('ov'),g=c.getContext('2d');g.clearRect(0,0,c.width,c.height);const b=drag||box;if(!b)return;
g.lineWidth=2;g.strokeStyle='#1f6fd1';g.strokeRect(b.x,b.y,b.w,b.h);const n=+$('n').value||1;g.setLineDash([4,3]);
for(let i=1;i<n;i++){const x=b.x+i*b.w/n;g.beginPath();g.moveTo(x,b.y);g.lineTo(x,b.y+b.h);g.stroke()}g.setLineDash([]);
if(last&&!drag)last.wheels.forEach(w=>{const[x,y,bw,bh]=w.box;g.strokeStyle=w.fitted?'#1a7f37':'#9a6700';g.lineWidth=1.5;g.strokeRect(x+.5,y+.5,bw,bh)})}
function capture(){last=null;$('status').textContent='Capturing...';$('img').src='/capture.jpg?flash='+($('flash').checked?1:0)+'&t='+Date.now()}
$('img').onload=()=>{const c=$('ov');c.width=$('img').naturalWidth;c.height=$('img').naturalHeight;draw();
$('status').textContent=`Frame ${c.width}x${c.height}. Drag a box around the digit window.`};
async function orient(){await fetch(`/config?hmirror=${$('hmirror').checked?1:0}&vflip=${$('vflip').checked?1:0}`);box=null;
try{localStorage.removeItem('amrBox')}catch(e){}capture()}
$('hmirror').onchange=orient;$('vflip').onchange=orient;
const pt=e=>{const r=$('ov').getBoundingClientRect();return{x:(e.clientX-r.left)*$('ov').width/r.width,y:(e.clientY-r.top)*$('ov').height/r.height}};
$('ov').onpointerdown=e=>{const p=pt(e);drag={x0:p.x,y0:p.y,x:p.x,y:p.y,w:0,h:0};$('ov').setPointerCapture(e.pointerId)};
$('ov').onpointermove=e=>{if(!drag)return;const p=pt(e);Object.assign(drag,{x:Math.min(drag.x0,p.x),y:Math.min(drag.y0,p.y),w:Math.abs(p.x-drag.x0),h:Math.abs(p.y-drag.y0)});draw()};
$('ov').onpointerup=()=>{if(drag&&drag.w>8&&drag.h>8){box={x:Math.round(drag.x),y:Math.round(drag.y),w:Math.round(drag.w),h:Math.round(drag.h)};last=null;
try{localStorage.setItem('amrBox',JSON.stringify(box))}catch(e){}}drag=null;draw()};
$('n').onchange=()=>{try{localStorage.setItem('amrN',$('n').value)}catch(e){}draw()};
async function read(){if(!box){$('status').textContent='Draw a box first.';return}
const q=new URLSearchParams({...box,n:$('n').value,fit:$('fit').checked?1:0});const r=await (await fetch('/read?'+q)).json();
if(r.error){$('status').textContent='Error: '+r.error;return}
last=r;draw();$('reading').textContent=r.reading;const nf=r.wheels.filter(w=>!w.fitted).length;
rows($('res'),[['Lowest confidence',`<span class="${r.min_p<0.5?'warn':''}">${r.min_p.toFixed(3)}${r.min_p<0.5?' (review)':''}</span>`],
['Capture',`${r.capture_ms.toFixed(1)} ms`],['Digit fitting (all wheels)',`${(r.fit_us/1000).toFixed(2)} ms`],
['Preprocessing (all wheels)',`${(r.preprocess_us/1000).toFixed(2)} ms`],['Inference (all wheels)',`${(r.inference_us/1000).toFixed(2)} ms`],
['Compute',`${r.macs.toLocaleString()} MACs`]]);
$('wh').innerHTML='<tr><th>#</th><th>Crop</th><th>Model input</th><th>Digit</th><th>p</th><th>Runner-up</th></tr>'+r.wheels.map((w,i)=>
`<tr class="wheel${w.p<0.5?' low':''}"><td>${i+1}</td><td class="mono">${w.fitted?'fitted':'cell'}</td><td><canvas data-i="${i}" width="24" height="32"></canvas></td><td class="mono">${w.digit}</td><td class="mono">${w.p.toFixed(3)}</td><td class="mono">${w.alt} (${w.p_alt.toFixed(3)})</td></tr>`).join('');
r.wheels.forEach((w,i)=>{const b=atob(w.input),c=document.querySelector(`canvas[data-i="${i}"]`),g=c.getContext('2d'),im=g.createImageData(24,32);
for(let k=0;k<768;k++){const v=b.charCodeAt(k);im.data.set([v,v,v,255],k*4)}g.putImageData(im,0,0)});
$('status').textContent=nf?`Read on device. ${nf} wheel(s) used the plain cell (no digit found): amber boxes.`:'Read on device. Green boxes are the crops the model saw.'}
$('cap').onclick=capture;$('read').onclick=read;$('rerun').onclick=()=>selftest(true);
selftest(false);capture();
</script></body></html>)HTML";

// ============================================================================
// Setup / loop
// ============================================================================
static void wifi_start() {
    if (strlen(WIFI_SSID)) {
        WiFi.mode(WIFI_STA);
        WiFi.begin(WIFI_SSID, WIFI_PASS);
        Serial.printf("Joining %s", WIFI_SSID);
        for (int i = 0; i < 30 && WiFi.status() != WL_CONNECTED; ++i) {
            delay(500);
            Serial.print('.');
        }
        Serial.println();
        if (WiFi.status() == WL_CONNECTED) {
            Serial.printf("Open http://%s\n", WiFi.localIP().toString().c_str());
            return;
        }
        Serial.println("Could not join; starting access point instead");
    }
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASS);
    Serial.printf("Join Wi-Fi \"%s\" (password %s), then open http://%s\n", AP_SSID, AP_PASS, WiFi.softAPIP().toString().c_str());
}

static void *big_alloc(size_t n) { return psramFound() ? ps_malloc(n) : malloc(n); }

void setup() {
    Serial.begin(115200);
    pinMode(FLASH_LED, OUTPUT);
    digitalWrite(FLASH_LED, LOW);
    delay(300);
    Serial.printf("\nPSRAM: %s\n", psramFound() ? "found" : "NOT found (enable it in Tools > PSRAM)");

    // Engine first, so its buffers and weights get internal SRAM before Wi-Fi does.
    if (!amr_init()) Serial.println("Model init failed: not enough internal memory");
    run_selftest();

    prefs.begin("amr", false);
    g_hmirror = prefs.getBool("hmirror", false);
    g_vflip = prefs.getBool("vflip", false);

    g_crop = (uint8_t *)big_alloc(MAX_CROP_W * MAX_CROP_H);
    g_search = (uint8_t *)big_alloc(SEARCH_MAX_PX);
    g_seen = (uint8_t *)big_alloc(SEARCH_MAX_PX);
    g_stack = (int32_t *)big_alloc(SEARCH_MAX_PX * sizeof(int32_t));
    if (!g_search || !g_seen || !g_stack) {
        Serial.println("Glyph search buffers unavailable; reads will use plain cells");
        g_search = nullptr;
    }
    if (!camera_init()) Serial.println("Camera init failed: check the ribbon cable and power supply");

    wifi_start();
    server.on("/", [] { server.send_P(200, "text/html", PAGE); });
    server.on("/selftest", handle_selftest);
    server.on("/config", handle_config);
    server.on("/capture.jpg", handle_capture);
    server.on("/read", handle_read);
    server.begin();
}

void loop() { server.handleClient(); }
